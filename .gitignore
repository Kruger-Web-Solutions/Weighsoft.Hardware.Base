# Device runtime config - NEVER commit. These are written by the board and hold
# live credentials: wifiSettings.json (WiFi password), securitySettings.json
# (JWT secret + user passwords), apSettings/otaSettings/mqttSettings (passwords).
/data/config/
# Generated by "pio run -t compiledb". It copies every -D build flag, including
# FACTORY_WIFI_PASSWORD, so it must never be committed either.
/compile_commands.json
